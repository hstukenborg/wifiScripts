#!/usr/bin/env bash

# This script is designed to setup the current Linux system to capture 802.11 monitor mode
# traffic from any or all available supported interfaces.

source "$(dirname "${BASH_SOURCE[0]}")/lib/wifi-common.sh"

# Functions

##############################################################################################################
#
# enableMonitor()
#
# Create monitor interfaces for the specified physical interfaces.
#
##############################################################################################################
function enableMonitor() {

  # Map every wlan-type interface to the phy it actually belongs to (see
  # listPhyInterfaceMap for why this replaces the old sorted/extracted
  # numeric-suffix pairing).
  declare -A aMappedInterfaces
  local -a aOrder=()
  local lphy lif

  while IFS='=' read -r lphy lif; do
    aMappedInterfaces[$lif]=$lphy
    aOrder+=("$lif")
  done < <(listPhyInterfaceMap)

  if [[ -n "$singleInterface" ]]; then
    if [[ -z "${aMappedInterfaces[$singleInterface]:-}" ]]; then
      err "Interface not found: $singleInterface"
      return 1
    fi
    aOrder=("$singleInterface")
  elif [[ "$noInternal" == "true" && ${#aOrder[@]} -gt 0 ]]; then
    # Assume the first interface `iw dev` reports is the internal adapter, and
    # skip it so the primary network connection survives the capture.
    aOrder=("${aOrder[@]:1}")
  fi

  if [[ "$verbose" == "true" ]]; then
    for lif in "${aOrder[@]}"; do
      err "$lif is ${aMappedInterfaces[$lif]}"
    done
  fi

  # Loop through the ordered interfaces and create a matching monitor for each.
  local monIndex=0
  for lif in "${aOrder[@]}"; do
    currentInt="$lif"
    currentPhy="${aMappedInterfaces[$lif]}"
    currentMon="mon${monIndex}"
    monIndex=$((monIndex + 1))

    if [[ "$verbose" == "true" ]]; then
      echo "current interface: $currentInt"
      echo "current phy: $currentPhy"
      echo "current monitor: $currentMon"
    fi

    # Hand the interface off from NetworkManager before touching it, instead
    # of fighting it mid-script or stopping the service system-wide.
    sudo nmcli device set "$currentInt" managed no 2>/dev/null

    # Enable the interface (just in case):
    sudo ip link show "$currentInt" | grep -w UP >/dev/null || sudo ip link set "$currentInt" up

    # Add a monitor-mode interface on the matching phy.
    sudo iw phy "$currentPhy" interface add "$currentMon" type monitor

    # Bring up the monitor interface.
    sudo ip link set "$currentMon" up

    # Initiate a scan via the source interface, but hide the results.
    # NOTE: This is specifically for Intel interfaces that rely upon
    # Location Aware Regulatory to enable channels for a given frequency
    # (specifically 6 GHz).
    sudo iw "$currentInt" scan > /dev/null

    # Set the region to US (by default):
    sudo iw reg set US

    # Bring down the source interface before attempting to capture traffic on the monitor interface.
    sudo ip link set "$currentInt" down
  done
}

##############################################################################################################
#
# disableMonitor()
#
# Remove the monitor mode interfaces and restore their parent interfaces to managed mode.
#
##############################################################################################################
function disableMonitor() {

  if [[ "$verbose" == "true" ]]; then
    err "Attempting to disable monitor interfaces."
  fi

  # Map every non-monitor interface to its phy, so each monitor interface can
  # be traced back to the interface it needs to restore via the phy the
  # kernel actually reports it on, rather than assuming a shared numeric
  # suffix (e.g. mon0 -> wlan0).
  declare -A aPhyToInterface
  local lphy lif
  while IFS='=' read -r lphy lif; do
    [[ "$lif" =~ ^mon[0-9]+$ ]] && continue
    aPhyToInterface[$lphy]=$lif
  done < <(listPhyInterfaceMap)

  local -a aMonitors=()
  mapfile -t aMonitors < <(iw dev | awk '/Interface/{print $2}' | grep -E '^mon[0-9]+$')

  # Bring down any online monitor interfaces and delete them.
  for monIf in "${aMonitors[@]}"; do
    local monPhy
    monPhy=$(iw dev "$monIf" info 2>/dev/null | awk '/wiphy/{print "phy"$2}')

    sudo ip link show "$monIf" | grep -w UP >/dev/null && sudo ip link set "$monIf" down
    sudo iw dev "$monIf" del

    # Restore the linked interface to managed.
    local parentInt="${aPhyToInterface[$monPhy]:-}"
    if [[ -n "$parentInt" ]]; then
      sudo iw "$parentInt" set type managed
      sudo ip link set "$parentInt" up
      sudo nmcli device set "$parentInt" managed yes 2>/dev/null

      if [[ "$verbose" == "true" ]]; then
        err "Removed monitor interface $monIf, restored $parentInt to managed"
      fi
    elif [[ "$verbose" == "true" ]]; then
      err "Removed monitor interface $monIf (no parent interface found to restore)"
    fi
  done

}

##############################################################################################################
#
# setChannel()
#
# Set the channel or frequency for the supplied monitor-mode interface
#
##############################################################################################################
function setChannel() {

  # 6 GHz PSC list:
  declare -a a6PSC
  a6PSC=(5 21 37 53 69 85 101 117 133 149 165 181 197 213 229)
  echo "${a6PSC[@]}"

}

##############################################################################################################
#
# listInterfaces()
#
##############################################################################################################
function listInterfaces() {

  # List all of the current physical interfaces along with the matching WLAN interface.
  listPhyInterfaceMap

}


##############################################################################################################
#
# showHelp()
#
##############################################################################################################
function showHelp() {
  echo "*******************************************************************************"
  echo "$(basename "$0") controls the monitor mode state on wireless interfaces.       "
  echo "*******************************************************************************"
  echo "Available options:"
  echo "-f <frequency>: Frequency to use to get the control channel."
  echo "-c <channel>: Channel to use to derive the frequency."
  echo "-b <band>: Specify which band to use. Options are 24,5,6."
  echo "-i <int>: Specify a specific interface to use. e.g. -i wlan1"
  echo "-l: list available interfaces"
  echo "-n: Ignore the internal interface. This allows maintaining a network connection"
  echo "    during capture."
  echo "-d: Disable monitor mode. Disables and deletes all monitor interfaces."
  echo "-v: Use verbose output."
  echo "-h: Show this help."
  echo ""

}

###############################################################################
################################# MAIN ########################################
###############################################################################

# Argument processing
verbose='false'
noInternal='false'
listInts='false'
useInterface=''
band=''
startChannel=''
startFrequency=''
disableMonitor='false'
clientChannel=''
centerFrequency=''

while getopts "c:f:b:i:ldnvh" flag; do
  case "${flag}" in
    c) startChannel="${OPTARG}" ;;
    f) startFrequency="${OPTARG}" ;;
    b) band="${OPTARG}" ;;
    i) useInterface="${OPTARG}" ;;
    l) listInts='true' ;;
    n) noInternal='true' ;;
    d) disableMonitor='true' ;;
    v) verbose='true' ;;
    h) showHelp; exit 0 ;;
    *) err "Invalid option: ${flag}" ;;
  esac
done

# If we're just doing channel/frequency conversion.
if [[ -n "$startChannel" ]]; then
  centerFrequency=$(calcCenterFreq "${startChannel}" "${band}")
  # Print out the center frequency
  if [[ "$verbose" == "true" ]]; then
    err "Frequency == $centerFrequency"
  else
    echo "$centerFrequency"
  fi
  exit
elif [[ -n "$startFrequency" ]]; then
  clientChannel=$(getChannelFromFrequency "${startFrequency}" "${band}")
  # Print out the client channel
  if [[ "$verbose" == "true" ]]; then
    err "Channel == $clientChannel"
  else
    echo "$clientChannel"
  fi
  exit
fi

# If they just want to list the available interfaces and exit.
if [[ "$listInts" == "true" ]]; then
  listInterfaces && exit
fi

# If we specified an interface to use, map that out.
if [[ -n "$useInterface" ]]; then
  singleInterface="$useInterface"
fi

if [[ "$disableMonitor" == "false" ]]; then
  enableMonitor
  if [[ "$verbose" == "true" ]]; then
    echo "Created the following monitor interfaces: "
    ip link show | grep -Eo '(mon[0-9]+)'
  fi
elif [[ "$disableMonitor" == "true" ]]; then
  disableMonitor
else
  err "Nothing to do - exiting."
  exit 1
fi
